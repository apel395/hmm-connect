APP_NAME=HMM Connect
APP_VERSION=0.1.0
DEBUG=false
SECRET_KEY=replace-with-a-random-value-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/erp_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=erp_db
DB_USER=postgres
DB_PASSWORD=postgres
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DOCUMENT_STORAGE_PATH=./uploads
MAX_DOCUMENT_SIZE_MB=10
ALLOWED_DOCUMENT_MIME_TYPES=application/pdf,image/jpeg,image/png,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.wordprocessingml.document
