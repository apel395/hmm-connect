# Copy to .env.production on the server and replace every secret.
POSTGRES_DB=erp_db
POSTGRES_USER=hmm
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
SECRET_KEY=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS

# The web container binds only to localhost by default; put Caddy/Nginx/Cloudflare Tunnel in front of it.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Frontend and API are same-origin in production (/api/v1), so CORS is normally not needed externally.
# If you expose the API separately, set the exact HTTPS frontend origin(s), comma separated.
CORS_ORIGINS=https://erp.example.com
